{
  "name": "xiaoyuanAI",
  "version": "1.0.1",
  "description": "小元AI - 在 Obsidian 中集成 AI 聊天、文本润色与维基管理",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run lint && npm run test && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "chat"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "eslint": "^10.4.1",
    "obsidian": "^1.5.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  }
}
