    {
      "name": "cross-linker",
      "description": "在维基页面之间建立和优化维基链接，增强知识连接",
      "autoRunInterval": 0
    },
    {
      "name": "tag-taxonomy",
      "description": "标准化维基页面的标签体系，确保标签命名一致且层级清晰",
      "autoRunInterval": 0
    },
    {
      "name": "wiki-update",
      "description": "同步维基状态，更新索引文件和 manifest，清理过期内容",
      "autoRunInterval": 0
    },
    {
      "name": "data-ingest",
      "description": "将任意原始文本数据摄入到 Obsidian 维基",
      "autoRunInterval": 0
    },
    {
      "name": "wiki-capture",
      "description": "将当前对话保存为永久的结构化维基笔记",
      "autoRunInterval": 0
    },
    {
      "name": "daily-update",
      "description": "执行日常维基维护，扫描变更并更新索引和状态文件",
      "autoRunInterval": 0
    },
    {
      "name": "wiki-rebuild",
      "description": "归档当前维基并重建，或从快照恢复维基",
      "autoRunInterval": 0
    }
